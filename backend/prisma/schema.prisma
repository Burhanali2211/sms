generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  email             String             @unique @db.VarChar(255)
  password_hash     String             @db.VarChar(255)
  name              String             @db.VarChar(255)
  role              String             @db.VarChar(50)
  status            String             @default("active") @db.VarChar(20)
  avatar_url        String?
  phone             String?            @db.VarChar(20)
  address           String?
  date_of_birth     DateTime?          @db.Date
  emergency_contact String?            @db.VarChar(255)
  last_login        DateTime?          @db.Timestamptz()
  created_at        DateTime           @default(now()) @db.Timestamptz()
  updated_at        DateTime           @updatedAt @db.Timestamptz()
  
  // Relations
  school            School?
  department        Department?
  classes           Class[]
  student           Student?
  teacher           Teacher?
  events_created    Event[]            @relation("EventCreator")
  events_participating EventParticipant[]
  notifications_created Notification[] @relation("NotificationCreator")
  notifications     UserNotification[]

  @@map("users")
}

model School {
  id               String       @id @default(uuid()) @db.Uuid
  name             String       @db.VarChar(255)
  address          String
  phone            String?      @db.VarChar(20)
  email            String?      @db.VarChar(255)
  principal_id     String?      @unique @db.Uuid
  principal        User?        @relation(fields: [principal_id], references: [id])
  established_date DateTime?    @db.Date
  website          String?      @db.VarChar(255)
  logo_url         String?
  created_at       DateTime     @default(now()) @db.Timestamptz()
  updated_at       DateTime     @updatedAt @db.Timestamptz()
  
  departments      Department[]

  @@map("schools")
}

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  description String?
  head_id     String?  @unique @db.Uuid
  head        User?    @relation(fields: [head_id], references: [id])
  school_id   String?  @db.Uuid
  school      School?  @relation(fields: [school_id], references: [id])
  created_at  DateTime @default(now()) @db.Timestamptz()
  updated_at  DateTime @updatedAt @db.Timestamptz()
  
  classes     Class[]

  @@map("departments")
}

model Class {
  id            String      @id @default(uuid()) @db.Uuid
  name          String      @db.VarChar(255)
  grade         String      @db.VarChar(10)
  section       String      @db.VarChar(10)
  subject       String?     @db.VarChar(255)
  teacher_id    String?     @db.Uuid
  teacher       User?       @relation(fields: [teacher_id], references: [id])
  department_id String?     @db.Uuid
  department    Department? @relation(fields: [department_id], references: [id])
  room_number   String?     @db.VarChar(50)
  capacity      Int         @default(30)
  schedule      Json?       @db.JsonB
  created_at    DateTime    @default(now()) @db.Timestamptz()
  updated_at    DateTime    @updatedAt @db.Timestamptz()
  
  students      Student[]

  @@map("classes")
}

model Student {
  id              String   @id @default(uuid()) @db.Uuid
  user_id         String?  @unique @db.Uuid
  user            User?    @relation(fields: [user_id], references: [id])
  student_id      String   @unique @db.VarChar(50)
  grade           String   @db.VarChar(10)
  section         String   @db.VarChar(10)
  class_id        String?  @db.Uuid
  class           Class?   @relation(fields: [class_id], references: [id])
  enrollment_date DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  parent_contact  String?  @db.VarChar(255)
  medical_info    String?
  attendance      Decimal  @default(0.00) @db.Decimal(5,2)
  gpa             Decimal  @default(0.00) @db.Decimal(3,2)
  created_at      DateTime @default(now()) @db.Timestamptz()
  updated_at      DateTime @updatedAt @db.Timestamptz()

  @@map("students")
  @@index([grade, section])
}

model Teacher {
  id               String   @id @default(uuid()) @db.Uuid
  user_id          String?  @unique @db.Uuid
  user             User?    @relation(fields: [user_id], references: [id])
  employee_id      String   @unique @db.VarChar(50)
  subject          String?  @db.VarChar(255)
  qualification    String?  @db.VarChar(255)
  experience_years Int      @default(0)
  created_at       DateTime @default(now()) @db.Timestamptz()
  updated_at       DateTime @updatedAt @db.Timestamptz()

  @@map("teachers")
}

model Event {
  id          String             @id @default(uuid()) @db.Uuid
  title       String             @db.VarChar(255)
  description String?
  start_date  DateTime           @db.Timestamptz()
  end_date    DateTime           @db.Timestamptz()
  location    String?            @db.VarChar(255)
  event_type  String             @default("general") @db.VarChar(50)
  color       String             @default("#3b82f6") @db.VarChar(7)
  created_by  String?            @db.Uuid
  creator     User?              @relation("EventCreator", fields: [created_by], references: [id])
  is_public   Boolean            @default(true)
  created_at  DateTime           @default(now()) @db.Timestamptz()
  updated_at  DateTime           @updatedAt @db.Timestamptz()
  
  participants EventParticipant[]

  @@map("events")
  @@index([start_date, end_date])
  @@index([event_type])
}

model EventParticipant {
  id         String   @id @default(uuid()) @db.Uuid
  event_id   String   @db.Uuid
  event      Event    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user_id    String   @db.Uuid
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  status     String   @default("going") @db.VarChar(20)
  created_at DateTime @default(now()) @db.Timestamptz()

  @@unique([event_id, user_id])
  @@map("event_participants")
}

model Notification {
  id         String             @id @default(uuid()) @db.Uuid
  title      String             @db.VarChar(255)
  message    String
  type       String             @default("info") @db.VarChar(50)
  created_by String?            @db.Uuid
  creator    User?              @relation("NotificationCreator", fields: [created_by], references: [id])
  action_url String?
  created_at DateTime           @default(now()) @db.Timestamptz()
  updated_at DateTime           @updatedAt @db.Timestamptz()
  
  user_notifications UserNotification[]

  @@map("notifications")
}

model UserNotification {
  id              String       @id @default(uuid()) @db.Uuid
  notification_id String       @db.Uuid
  notification    Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  user_id         String       @db.Uuid
  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  is_read         Boolean      @default(false)
  read_at         DateTime?    @db.Timestamptz()
  created_at      DateTime     @default(now()) @db.Timestamptz()

  @@unique([notification_id, user_id])
  @@map("user_notifications")
  @@index([user_id, is_read])
}
